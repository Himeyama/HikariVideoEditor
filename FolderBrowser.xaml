<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:VideoEditor" x:Class="VideoEditor.FolderBrowser">
    <Grid MinWidth="480" Height="400" RowSpacing="8" ColumnSpacing="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Click="Parent_Click" ToolTipService.ToolTip="上のフォルダー" AutomationProperties.Name="上のフォルダー">
                <FontIcon Glyph="" FontSize="16"/>
            </Button>
            <Button Grid.Column="1" Click="Home_Click" ToolTipService.ToolTip="ホーム" AutomationProperties.Name="ホーム"><FontIcon Glyph="&#xE80F;" FontSize="16"/></Button>
            <TextBox x:Name="Address" Grid.Column="2" KeyDown="Address_KeyDown" AutomationProperties.Name="フォルダーのパス"/>
            <Button Grid.Column="3" Content="移動" Click="Navigate_Click"/>
        </Grid>
        <ListView x:Name="Folders" Grid.Row="1" DoubleTapped="Folders_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:WorkspaceEntry">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind Icon}" FontSize="16"/>
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="ErrorText" Grid.Row="2" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
    </Grid>
</UserControl>

